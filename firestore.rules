rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules)
service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user can read/write only their own profile document
    // at users/{their-uid}. This is what auth_service.dart's signUp()
    // writes to. If this file was never deployed, Firestore's default
    // rules deny ALL access — that's the #1 cause of "account created in
    // Auth but signup shows an error" bugs.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reserved-username pattern: doc id is the lowercased username, value
    // is { uid: <owner> }. Any signed-in user can read this (needed to
    // check availability before claiming a name), but can only create or
    // delete a claim that points at their own uid — never edit someone
    // else's claim or rewrite one in place (release + re-claim instead).
    match /usernames/{usernameLower} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Store directory — public within the signed-in app, not user-owned.
    // Any signed-in user can read; writes are open for now so the client
    // can seed demo data (MarketService.seedDemoDataIfEmpty) and a vendor
    // can eventually edit their own listing. Before shipping to real
    // users, replace `allow write` with a check against a vendor/admin
    // role (e.g. a custom claim), or move writes into a Cloud Function.
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // The 49-plot market grid. Any signed-in user can read the whole grid
    // (needed to render availability). Once a stall doc exists, a write
    // may only:
    //  (a) claim it for the requester's own uid, and ONLY if it wasn't
    //      already booked by someone else — this is what actually stops
    //      stall-stealing at the database level, not just in the client's
    //      transaction logic; or
    //  (b) release a stall the requester currently owns.
    // A doc that doesn't exist yet can be created with any initial state —
    // that's what MarketService.seedDemoDataIfEmpty needs (some seeded
    // stalls start pre-booked with no owner, to look like a real market).
    // MarketService.bookStall's transaction prevents the *race* (two people
    // tapping "Rent" at once); this rule prevents someone bypassing the app
    // entirely and overwriting a stall they don't own via a raw API call.
    match /stalls/{stallCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        resource == null ||
        (
          request.resource.data.booked == true &&
          request.resource.data.bookedByUid == request.auth.uid &&
          resource.data.booked != true
        ) ||
        (
          request.resource.data.booked == false &&
          resource.data.bookedByUid == request.auth.uid
        )
      );
    }

    // A user's own booking history. Created by MarketService.bookStall in
    // the same transaction as the stall claim above, so a booking only
    // ever exists if the uid on it matches who actually won that stall.
    match /bookings/{bookingId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if false; // keep booking history immutable
    }

    // A vendor's own sales log entries — see AnalyticsService.
    match /salesLogs/{logId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // A user's own notification inbox, stored as a subcollection so it's
    // automatically scoped and easy to bulk-delete. See NotificationService.
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
